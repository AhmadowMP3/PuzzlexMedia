# Copy to .env and fill in. Never commit .env.

# Public address of the site (share previews, sitemap). Default: https://www.puzzlexmedia.com
SITE_URL=https://www.puzzlexmedia.com

# Set to 1 when the site runs behind nginx/Caddy/Traefik/Cloudflare (reads the visitor's real IP)
TRUST_PROXY=1

# Contact form email. Leave SMTP_HOST empty to only save messages to /data/messages.jsonl
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
# 1 for port 465 (SSL), 0 for 587 (STARTTLS)
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# The sender address; most providers require it to be the SMTP account itself
SMTP_FROM=
